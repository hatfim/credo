  --cr-alpha-destructive-5: rgba(222, 75, 105, 0.050980392156862744);
  --cr-shadow-color-default: rgba(0, 0, 0, 0.07058823529411765);
}

:root {
  --cr-display-large-font-size: 2.5rem;
