{
  "name": "@usecredo/test-utils",
  "version": "0.0.0",
  "description": "Shared decorators, fixtures and test setup",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatfim/credo.git",
    "directory": "packages/test-utils"
  },
  "type": "module",
  "sideEffects": [
    "./dist/setup.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./a11y": {
      "types": "./dist/a11y.d.ts",
      "import": "./dist/a11y.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@usecredo/eslint-config": "workspace:*",
    "@usecredo/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@testing-library/jest-dom": "catalog:",
    "axe-core": "catalog:"
  },
  "peerDependencies": {
    "@testing-library/react": "^16.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "vitest": ">=3.0.0"
  }
}
