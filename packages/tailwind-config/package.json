{
  "name": "@usecredo/tailwind-config",
  "version": "0.0.0",
  "description": "Tailwind CSS v4 mapping for the Credo token contract",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatfim/credo.git",
    "directory": "packages/tailwind-config"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs && pnpm check:package",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./theme.css"
  },
  "peerDependencies": {
    "@usecredo/tokens": "workspace:^",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@types/node": "catalog:",
    "@usecredo/eslint-config": "workspace:*",
    "@usecredo/tokens": "workspace:*",
    "@usecredo/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "publint": "catalog:",
    "tailwindcss": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
