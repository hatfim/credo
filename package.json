{
  "name": "credo",
  "version": "0.0.0",
  "private": true,
  "description": "Credo Design System monorepo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:hatfim/credo.git"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "syncpack lint && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "check": "syncpack lint && turbo run lint typecheck test build",
    "clean": "turbo run clean",
    "lint:deps": "syncpack lint",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "syncpack": "catalog:",
    "turbo": "catalog:"
  }
}
